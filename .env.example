# Public/runtime configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_AGENT_URL=http://localhost:8000/v1

# Server-only secrets. Set these in the runtime environment; never commit them.
PAYLOAD_SECRET=replace-with-a-long-random-secret
HELLOADA_CONTROL_PLANE_TOKEN=replace-with-the-shared-server-token

# Optional local Cloudflare proxy settings
CLOUDFLARE_ENV=
CLOUDFLARE_REMOTE_BINDINGS=0
